@using ASPFutoVerseny.Controllers
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<HomeController> Localizer
@model List<Versenyzo>
@{
    ViewData["Title"] = Localizer["Runners"];
}

@{
    string info = (string)TempData["info"];
    string error = (string)TempData["error"];
}

@if (!string.IsNullOrEmpty(info))
{
    <div class="alert alert-dismissible fade show alert-success" role="alert">
        @info
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-dismissible fade show alert-danger" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<h1>@ViewData["Title"]</h1>

<partial name="~/Views/Partials/_AddButton.cshtml" />

@if (Model == null || !Model.Any())
{
    <p>Nincs versenyző.</p>
}
else
{
    <ul class="list-group">
    @foreach (var item in Model)
    {
        <li class="list-group-item">
            <dl class="row mb-0">
                <dt class="col-sm-3">Név</dt>
                <dd class="col-sm-9">@item.Nev</dd>
            </dl>
        </li>
    }
    </ul>
}

<canvas id="diagram" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    @{
        var adatok = Model?.GroupBy(v => v.Tav).Select(cs => new { Tav = cs.Key, Szamlalo = cs.Count() });
    }
    let context = document.getElementById("diagram");
    let ertekek = [@(String.Join(',', adatok.Select(a => a.Szamlalo)))];
    let felosztas = [@(String.Join(',', adatok.Select(a => a.Tav)))];

    new Chart(context, {
        options: {
            plugins: {
                title: {
                    display: true,
                    text: "diagram",
                }
            },
            scales: {
                y: {
                    ticks: {
                        stepSize: 1
                    }
                }
            },
            tooltip: {
                mode: 'index',
                bodyColor: "ff0000",
                callbacks: {
                    label: function(context) {
                        return '@Localizer["Runners"]: ' + context.raw;
                    }
                }
            }
        },
        data: {
            labels: felosztas,
            datasets: [
                {
                    type: 'bar',
                    label: 'Versenyzők száma táv szerint',
                    data: ertekek,
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                },
                {
                    type: 'line',
                    label: 'Versenyzők száma táv szerint',
                    data: ertekek,
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                }
            ]
        }
    });
</script>
