@model List<Versenyzo>
@{
    ViewData["Title"] = "Versenyzők";
}

<h1>@ViewData["Title"]</h1>

<partial name="~/Views/Partials/_AddButton.cshtml" />

@if (Model == null || !Model.Any())
{
    <p>Nincs versenyző.</p>
}
else
{
    <ul class="list-group">
    @foreach (var item in Model)
    {
        <li class="list-group-item">
            <dl class="row mb-0">
                <dt class="col-sm-3">Név</dt>
                <dd class="col-sm-9">@item.Nev</dd>
            </dl>
        </li>
    }
    </ul>
}

